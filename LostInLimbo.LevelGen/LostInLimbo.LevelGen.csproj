<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion> 
    <Nullable>enable</Nullable>
    <Version>0.0.6</Version>
  </PropertyGroup>

  <!-- NuGet package metadata. Version above is the single source of truth for the package version (see Api/LibraryInfo, which reads it). -->
  <PropertyGroup>
    <PackageId>LostInLimbo.LevelGen</PackageId>
    <Authors>Mader Levap</Authors>
    <Description>Engine-neutral procedural level and chunk generation library for Lost in Limbo.</Description>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/mader-levap/lil-level-gen</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mader-levap/lil-level-gen.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>level-generation;procedural-generation;gamedev;lost-in-limbo</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>

  <!-- Allow the test project to exercise internal types (generator internals, status store). -->
  <ItemGroup>
    <InternalsVisibleTo Include="LostInLimbo.LevelGen.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
